{
  "name": "@lingo/core-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript core of Lingo: the same rules as the Swift LingoCore, checked against packages/contracts.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "tsc -p tsconfig.test.json && vitest run",
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
