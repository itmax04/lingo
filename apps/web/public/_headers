# Headers of the static site (spec FR-55). The Worker sets the same values on its own responses
# (services/engine/src/http.ts); services/engine/test/shell.test.ts compares the two.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self' https://api.groq.com https://api.mistral.ai https://openrouter.ai; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
