    "History is shared between devices through a folder in iCloud Drive: each device writes only its own journal. No paid developer features are needed. iCloud decides when changes appear on another device — sync is not instant.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History is shared between devices through a folder in iCloud Drive: each device writes only its own journal. No paid developer features are needed. iCloud decides when changes appear on another device — sync is not instant."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История передаётся через папку iCloud Drive: каждое устройство записывает только свой журнал. Платные функции разработчика не нужны. Задержка зависит от iCloud — синхронизация не мгновенная."
          }
        }
      },
      "extractionState": "manual"
    },
