// Lingo Engine (ADR-0002, WR-27): one Worker serving the static web client and the API, one D1 database.
// Local only until the owner's H-2a setup: `database_id` is a placeholder, there is no remote binding and no secret here.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lingo",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // API and sign-in routes always reach the Worker; everything else is a static asset (the PWA from P-15).
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lingo",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": false }
}
